model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_QueryOrder = ["DatabaseHost","DatabaseName","Games","Sessions","Achievements","Playtime Snapshots","Date","Live Activity","Activity Heatmap","Sync Status","Data Quality","Measures"]

	ref table Games
	ref table Sessions
	ref table Achievements
	ref table 'Playtime Snapshots'
	ref table Date
	ref table 'Live Activity'
	ref table 'Activity Heatmap'
	ref table 'Sync Status'
	ref table 'Data Quality'
	ref table Measures

	ref cultureInfo en-GB
