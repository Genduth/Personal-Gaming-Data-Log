table 'Activity Heatmap'
	lineageTag: 707504f4-e865-43bb-9068-606588f7de48

	measure 'Heatmap Hours' = DIVIDE(SUM('Activity Heatmap'[duration_seconds]), 3600)
		formatString: 0.0
		lineageTag: c959f289-e7cc-48ef-8c3e-c61403d82d1c

	column weekday_number
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: weekday_number

	column weekday_name
		dataType: string
		sortByColumn: weekday_number
		summarizeBy: none
		sourceColumn: weekday_name

	column start_hour
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: start_hour

	column session_count
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: session_count

	column duration_seconds
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: duration_seconds

	partition 'Activity Heatmap' = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(DatabaseHost, DatabaseName),
				    Data = Source{[Schema="powerbi", Item="activity_heatmap"]}[Data]
				in
				    Data

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
