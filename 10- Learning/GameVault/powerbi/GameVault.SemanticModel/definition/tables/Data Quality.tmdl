table 'Data Quality'
	lineageTag: 2a1c6154-415e-4357-a8bd-d065fd714280

	column check_name
		dataType: string
		summarizeBy: none
		sourceColumn: check_name

	column issue_count
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: issue_count

	column last_observed_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: last_observed_at

	partition 'Data Quality' = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(DatabaseHost, DatabaseName),
				    Data = Source{[Schema="powerbi", Item="data_quality"]}[Data]
				in
				    Data

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
