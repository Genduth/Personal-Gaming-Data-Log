		dataType: string
		summarizeBy: none
		sourceColumn: game_id

	column title
		dataType: string
		summarizeBy: none
		sourceColumn: title

	column cover_url
		dataType: string
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: cover_url

	column device_name
		dataType: string
		summarizeBy: none
		sourceColumn: device_name

	column executable
		dataType: string
		summarizeBy: none
