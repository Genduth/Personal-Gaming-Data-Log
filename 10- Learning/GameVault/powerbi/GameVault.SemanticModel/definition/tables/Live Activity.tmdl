	column presence_status
		dataType: string
		summarizeBy: none
		sourceColumn: presence_status

	partition 'Live Activity' = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(DatabaseHost, DatabaseName),
				    Data = Source{[Schema="powerbi", Item="live_activity"]}[Data]
				in
				    Data

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
