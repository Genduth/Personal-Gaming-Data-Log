		summarizeBy: none
		sourceColumn: provider

	column status
		dataType: string
		summarizeBy: none
		sourceColumn: status

	column started_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: started_at

	column finished_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
