	column rarity_percent
		dataType: decimal
		formatString: 0.0
		summarizeBy: average
		sourceColumn: rarity_percent

	partition Achievements = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database(DatabaseHost, DatabaseName),
				    Data = Source{[Schema="powerbi", Item="achievements"]}[Data]
				in
				    Data

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
