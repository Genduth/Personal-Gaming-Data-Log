table Achievements
	lineageTag: fcd681fe-529c-4f82-abaa-65a65dc9c46f

	column achievement_id
		dataType: string
		summarizeBy: none
		sourceColumn: achievement_id

	column game_id
		dataType: string
		summarizeBy: none
		sourceColumn: game_id

	column provider
		dataType: string
		summarizeBy: none
		sourceColumn: provider

	column external_id
		dataType: string
		summarizeBy: none
		sourceColumn: external_id

	column name
		dataType: string
		summarizeBy: none
		sourceColumn: name

	column description
		dataType: string
		summarizeBy: none
		sourceColumn: description

	column icon_url
		dataType: string
		dataCategory: ImageUrl
		summarizeBy: none
		sourceColumn: icon_url

	column is_unlocked
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_unlocked

	column unlocked_at
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
