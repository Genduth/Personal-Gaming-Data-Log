POSTGRES_DB=gamevault
POSTGRES_USER=gamevault
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://gamevault:change-me@db:5432/gamevault

# Shared by the API and each collector. Use a long random value.
COLLECTOR_TOKEN=change-me-too

# Steam backfill (optional until you run a Steam sync).
STEAM_API_KEY=
STEAM_ID=
STEAM_ACHIEVEMENT_GAME_LIMIT=100

# Collector configuration (used on the gaming PC, not inside Docker).
GAMEVAULT_API_URL=http://localhost:8000
GAMEVAULT_DEVICE_NAME=Gaming-PC
GAMEVAULT_POLL_SECONDS=15
